# MemoryLedger — environment configuration
# Copy to .env and fill in real values at the event. NEVER commit .env.

# ---------------------------------------------------------------------------
# Provider selection.  "sim" runs entirely offline against faithful simulators.
# "real" hits Snowflake Cortex / EverOS Cloud / Snowflake tables.
# These three switch independently so we can bring providers up one at a time
# at the event instead of flipping everything and debugging three things.
# ---------------------------------------------------------------------------
CORTEX_PROVIDER=sim          # sim | real
EVEROS_PROVIDER=sim          # sim | real
LEDGER_PROVIDER=sqlite       # sqlite | snowflake

# ---------------------------------------------------------------------------
# Snowflake Cortex (Anthropic-Messages-compatible REST API)
# base_url is https://<account>.snowflakecomputing.com/api/v2/cortex
# Auth is a Programmatic Access Token (PAT) sent as `Authorization: Bearer <PAT>`.
# ---------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=            # e.g. abc12345.us-east-1  (account locator or org-account)
SNOWFLAKE_PAT=                # programmatic access token — SECRET
CORTEX_BASE_URL=              # optional explicit override of the derived base_url
CORTEX_MODEL=claude-sonnet-4-5 # model name as exposed by Cortex

# ---------------------------------------------------------------------------
# Snowflake connection for the ledger tables + reconciliation queries
# ---------------------------------------------------------------------------
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=           # SECRET (or use SNOWFLAKE_PAT with authenticator=oauth)
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=MEMORYLEDGER
SNOWFLAKE_SCHEMA=LEDGER   # must match sql/01_ddl.sql

# ---------------------------------------------------------------------------
# EverOS / EverMind memory layer
#
# PLAN CHANGE 2026-08-07: self-hosted, not cloud. Free, no per-operation
# charge, and it removes a network hop — venue wifi is the biggest live-failure
# risk we have. Cloud remains a one-line fallback: point the base URL back at
# https://api.evermind.ai and set EVEROS_API_KEY.
#
#   docker compose up -d everos      # published on host port 8077
#   curl localhost:8077/health       # -> {"status":"ok"}
#
# EverOS defaults to port 8000, which we already use. It keeps 8000 inside its
# container; compose maps it to 8077 on the host.
# ---------------------------------------------------------------------------
EVEROS_BASE_URL=http://localhost:8077   # self-hosted. Cloud: https://api.evermind.ai
EVEROS_API_KEY=               # SECRET. Leave EMPTY for self-hosted; required for cloud.
EVEROS_AGENT_ID=memoryledger-tutor
EVEROS_APP_ID=memoryledger
EVEROS_PROJECT_ID=hackathon

# ---------------------------------------------------------------------------
# Keys that self-hosted EverOS needs for its own extraction pipeline.
#
# >>> THESE ARE OUR OWN KEYS, NOT SPONSOR KEYS. SOMEBODY HAS TO SUPPLY THEM. <<<
#
# EverOS runs its own LLM and embedding calls to turn conversations into typed
# memories. That spend is ours and is separate from the Snowflake trial credit.
# Only used by the `everos` container; our service never reads them.
# The project's README recommends OpenRouter for the LLM and DeepInfra for
# embeddings; any OpenAI-protocol-compatible endpoint should work.
# ---------------------------------------------------------------------------
EVEROS_LLM__API_KEY=          # SECRET — required for self-hosted
EVEROS_EMBEDDING__API_KEY=    # SECRET — required for self-hosted
EVEROS_MULTIMODAL__API_KEY=   # SECRET — optional
EVEROS_RERANK__API_KEY=       # SECRET — optional
EVEROS_LLM__BASE_URL=         # optional endpoint override
EVEROS_EMBEDDING__BASE_URL=   # optional endpoint override

# ---------------------------------------------------------------------------
# Local storage
# ---------------------------------------------------------------------------
SQLITE_PATH=data/ledger.db

# ---------------------------------------------------------------------------
# Assembler behaviour
# ---------------------------------------------------------------------------
ASSEMBLY_MODE=tiered          # tiered | naive  (default mode; UI can override per request)
PROMOTION_STABILITY_N=3       # calls a memory must be content-stable before promotion
MIN_CACHEABLE_TOKENS=1024     # Anthropic/Cortex minimum prefix length for caching
MAX_CACHE_BREAKPOINTS=4
CACHE_TTL_SECONDS=300         # 5 minutes

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
PORT=8000
